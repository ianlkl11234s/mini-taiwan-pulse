# ── 必填：沒有這三個站台跑不起來 ──────────────────────────────────────
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Supabase（gis-platform）—— 絕大多數動態圖層的資料來源，未設會整片空白
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── 選填 ─────────────────────────────────────────────────────────────
VITE_WASTE_MATCHED_TRAILS=1
FR24_API_TOKEN=your_flightradar24_api_token_here

# 本機 GIS MCP browser bridge（只供 npm run dev；三項同時設定才啟用）
# Token 會進入 Vite dev bundle，只能用於本機開發，且須與 mini-pulse-gis-mcp/.env 相同。
# VITE_MCP_BRIDGE_ENABLED=1
# VITE_MCP_BRIDGE_PORT=4731
# VITE_MCP_BRIDGE_TOKEN=replace_with_a_random_token_at_least_16_chars

# CWA 衛星/雷達影像讀取路徑（AR-11d feature flag）
# 未設 → 走既有 base64 RPC（get_cwa_imagery_frames_batch）；有值 → 走 R2/CDN URL（get_cwa_imagery_manifest）
# 開發用 r2.dev base（有 rate limit，正式請綁 custom domain）
# VITE_IMAGERY_CDN_BASE=https://pub-eae6980c040441adbd1eaded2870d3d2.r2.dev

# S3 (upload script)
S3_BUCKET=migu-gis-data-collector
S3_ACCESS_KEY=your_aws_access_key_here
S3_SECRET_KEY=your_aws_secret_key_here
S3_REGION=ap-southeast-2

# ── EM-06 嵌入版 /embed 底圖 ────────────────────────────────────────────
# Protomaps OSM 底圖（PMTiles）位置。不設則用預設 /base_map/taiwan_basemap.pmtiles，
# 走既有部署管線（public/base_map/ → S3 deploy-assets/base_map/ → 容器 /data/base_map/）。
# 若改放 Cloudflare R2（egress 免費、適合高流量嵌入）在此填完整 URL：
# VITE_EMBED_BASEMAP_URL=https://<r2-custom-domain>/base_map/taiwan_basemap.pmtiles
