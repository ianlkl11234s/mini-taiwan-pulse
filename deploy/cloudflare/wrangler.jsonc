{
  "name": "mini-taiwan-pulse-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "ORIGIN": "https://mini-taiwan-pulse.itsmigu.com" },
  "observability": { "enabled": true }
}
