{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsmigu.com/schemas/semantic-card/0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "semanticVersion", "datasetId", "datasetVersion", "label", "recordGrain", "geometry", "versions", "requiredEvidence", "concepts", "allowedAnalyses", "prohibitedClaims"],
  "properties": {
    "schemaVersion": { "const": "semantic-card/0.1" }, "semanticVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "datasetId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$" }, "datasetVersion": { "type": ["string", "null"] }, "label": { "$ref": "#/$defs/text" }, "recordGrain": { "enum": ["place", "event", "admin_statistic"] }, "geometry": { "$ref": "#/$defs/geometry" },
    "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }, "requiredEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRequirement" } }, "concepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/concept" } }, "allowedAnalyses": { "$ref": "#/$defs/textArray" }, "prohibitedClaims": { "$ref": "#/$defs/nonEmptyTextArray" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 2000 }, "textArray": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "nonEmptyTextArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "geometry": { "type": "object", "additionalProperties": false, "required": ["role", "spatialAnalysisEligible", "meaning"], "properties": { "role": { "enum": ["actual", "proxy", "none"] }, "spatialAnalysisEligible": { "type": "boolean" }, "meaning": { "$ref": "#/$defs/text" } } },
    "version": { "type": "object", "additionalProperties": false, "required": ["datasetVersion", "sourceVersion", "freshness", "note"], "properties": { "datasetVersion": { "type": ["string", "null"] }, "sourceVersion": { "type": ["string", "null"] }, "freshness": { "enum": ["current", "stale", "unknown"] }, "note": { "$ref": "#/$defs/text" } } },
    "evidenceRequirement": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "description"], "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" } } },
    "method": { "type": "object", "additionalProperties": false, "required": ["methodId", "version"], "properties": { "methodId": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["spatialScale", "timeScale"], "properties": { "spatialScale": { "$ref": "#/$defs/text" }, "timeScale": { "$ref": "#/$defs/text" } } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["level", "rationale"], "properties": { "level": { "enum": ["unknown", "low", "medium", "high"] }, "rationale": { "$ref": "#/$defs/text" } } },
    "concept": { "type": "object", "additionalProperties": false, "required": ["conceptId", "kind", "definition", "method", "scope", "confidence", "evidenceStatus", "references", "reviewSource", "requiredEvidence", "allowedAnalyses", "prohibitedClaims"], "properties": { "conceptId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["observed", "derived", "proxy", "hypothesis"] }, "definition": { "$ref": "#/$defs/text" }, "method": { "$ref": "#/$defs/method" }, "scope": { "$ref": "#/$defs/scope" }, "confidence": { "$ref": "#/$defs/confidence" }, "evidenceStatus": { "enum": ["requires_validation", "reviewed"] }, "references": { "$ref": "#/$defs/nonEmptyTextArray" }, "reviewSource": { "$ref": "#/$defs/text" }, "requiredEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "allowedAnalyses": { "$ref": "#/$defs/textArray" }, "prohibitedClaims": { "$ref": "#/$defs/nonEmptyTextArray" } } }
  }
}
