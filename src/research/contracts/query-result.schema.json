{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mini-taiwan-pulse.local/pulse-query-result/0.1/query-result.schema.json",
  "title": "Pulse bounded query result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "queryHash", "datasetId", "executionStatus", "method", "sourceRefs", "recordGrain", "countGrain", "units", "coverage", "freshness", "totalMatched", "returned", "displayTruncated", "analysisComplete", "excludedByReason", "rows", "cost", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": "pulse-query-result/0.1" },
    "resultId": { "type": "string", "pattern": "^result-[a-f0-9]{24}$" },
    "queryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "datasetId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$" },
    "executionStatus": { "const": "complete" },
    "method": {
      "type": "object", "additionalProperties": false, "required": ["operation", "version", "parameters"],
      "properties": { "operation": { "const": "query_records" }, "version": { "const": "0.1" }, "parameters": { "$ref": "#/$defs/jsonData" } }
    },
    "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/sourceReceipt" } },
    "recordGrain": { "$ref": "#/$defs/grain" },
    "countGrain": { "$ref": "#/$defs/grain" },
    "units": { "type": "object", "maxProperties": 50, "additionalProperties": { "type": ["string", "null"], "maxLength": 160 } },
    "coverage": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "freshness": { "enum": ["current", "stale", "unknown"] },
    "totalMatched": { "type": "integer", "minimum": 0 },
    "returned": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "displayTruncated": { "type": "boolean" },
    "analysisComplete": { "type": "boolean" },
    "excludedByReason": { "type": "object", "maxProperties": 100, "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,79}$" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "rows": { "type": "array", "maxItems": 1000, "items": { "type": "object", "maxProperties": 50, "additionalProperties": { "$ref": "#/$defs/jsonData" } } },
    "cost": {
      "type": "object", "additionalProperties": false, "required": ["rowsScanned", "bytesScanned", "downloadedBytes", "requests", "cacheHit"],
      "properties": { "rowsScanned": { "type": "integer", "minimum": 0, "maximum": 100000 }, "bytesScanned": { "type": ["integer", "null"], "minimum": 0 }, "downloadedBytes": { "type": ["integer", "null"], "minimum": 0 }, "requests": { "type": ["integer", "null"], "minimum": 0 }, "cacheHit": { "type": ["boolean", "null"] } }
    },
    "expiresAt": { "anyOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] }
  },
  "$defs": {
    "grain": { "enum": ["place", "event", "admin_statistic"] },
    "instant": { "type": "string", "format": "date-time" },
    "sourceReceipt": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "version", "acquiredAt", "checksumSha256", "reference"],
      "properties": { "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 }, "version": { "type": "string", "minLength": 1, "maxLength": 4000 }, "acquiredAt": { "$ref": "#/$defs/instant" }, "checksumSha256": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] }, "reference": { "type": "string", "minLength": 1, "maxLength": 4000 } }
    },
    "jsonData": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonData" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonData" } }
      ]
    }
  }
}
